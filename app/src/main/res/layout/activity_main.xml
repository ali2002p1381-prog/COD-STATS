<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Dark / Light switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end">

            <Button
                android:id="@+id/themeButton"
                android:layout_width="45dp"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="☾"
                android:textSize="18sp" />

        </LinearLayout>


        <!-- Tab -->
        <TextView
            android:id="@+id/tabTitle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="جدول"
            android:textSize="20sp"
            android:textStyle="bold" />


        <!-- TABLE -->

        <TableLayout
            android:id="@+id/tableLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="0,1,2">


            <!-- HEADER -->

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <TextView
                    android:id="@+id/headerPlayer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Player"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/headerManfi"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Manfi"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/headerMablagh"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Mablagh"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </TableRow>


            <!-- ROW 1 -->

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <EditText
                    android:id="@+id/player1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="Player 1"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/b1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="0"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/c1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="15sp" />

            </TableRow>


            <!-- ROW 2 -->

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <EditText
                    android:id="@+id/player2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="Player 2"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/b2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="0"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/c2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="15sp" />

            </TableRow>


            <!-- ROW 3 -->

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <EditText
                    android:id="@+id/player3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="Player 3"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/b3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="0"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/c3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="15sp" />

            </TableRow>


            <!-- ROW 4 -->

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <EditText
                    android:id="@+id/player4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="Player 4"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/b4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="0"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/c4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="15sp" />

            </TableRow>


            <!-- ROW 5 -->

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <EditText
                    android:id="@+id/player5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="Player 5"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/b5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="0"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/c5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="15sp" />

            </TableRow>


            <!-- ROW 6 -->

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <EditText
                    android:id="@+id/player6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="Player 6"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/b6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="0"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/c6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="15sp" />

            </TableRow>


            <!-- ROW 7 -->

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <EditText
                    android:id="@+id/player7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="Player 7"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/b7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="0"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/c7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="15sp" />

            </TableRow>

        </TableLayout>


        <!-- D1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="پول دستگاه ها"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/d1"
                android:layout_width="140dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:hint="0"
                android:inputType="number"
                android:singleLine="true" />

        </LinearLayout>


        <!-- E1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="جمع منفی ها"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/e1"
                android:layout_width="140dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="0"
                android:textSize="16sp" />

        </LinearLayout>


        <!-- RESET -->

        <Button
            android:id="@+id/resetButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:text="RESET" />

    </LinearLayout>

</ScrollView>
